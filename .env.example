# ==============================================================================
# HamsterDesk — Server Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env to configure server-level defaults.
#
# NOTE: Public users can also enter their own keys in the web UI (Config tab).
# Keys entered in the UI are stored safely in their browser's LocalStorage and
# passed directly with their requests without being saved on the server.
# ==============================================================================

# ── LLM Provider API Keys (Optional Server Fallbacks) ─────────────────────────
# Free Gemini key: https://aistudio.google.com/
GEMINI_API_KEY=

# DeepSeek key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ── Voice Provider API Keys (Optional) ───────────────────────────────────────
# Deepgram key for fast STT / TTS: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Fish Audio key: https://fish.audio/app/developers
FISH_AUDIO_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
# Character Voice Model Reference IDs (from https://fish.audio/m/<model_id>)
FISH_AUDIO_ID_KRISHNA=
FISH_AUDIO_ID_HAMSTER=
FISH_AUDIO_ID_PANDA=

# ── Default Model / Provider Configuration ────────────────────────────────────
DEFAULT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat

# Ollama local endpoint (if using Ollama provider)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3

# Voice mode: "deepgram" (cloud TTS) or "apple" (macOS say / browser TTS)
VOICE_MODE=apple

# ── Server & Security ────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ── Krishna Companion (Madhav) ────────────────────────────────────────────────
# Structured log level for the Krishna subsystem: DEBUG, INFO, WARNING, ERROR.
# User message content is never logged at any level — only classification.
KRISHNA_LOG_LEVEL=INFO

# Native provider function calling for ACTION tools (createTask, startFocus,
# saveMemory). Off by default: Gita and memory retrieval is done
# deterministically by the backend on every turn, which is more reliable and
# works offline. Turn this on only if you want the model to invoke actions
# itself, and verify it against your provider first.
KRISHNA_NATIVE_TOOLS=0
