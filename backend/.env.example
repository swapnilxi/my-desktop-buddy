# ==============================================================================
# HamsterDesk Backend Environment Variables (.env.example)
# ==============================================================================

# LLM API Keys (Optional Server Fallback)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Voice API Keys
DEEPGRAM_API_KEY=

# Fish Audio TTS Configuration
FISH_AUDIO_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
# Character Voice Model Reference IDs (from https://fish.audio/m/<model_id>)
FISH_AUDIO_ID_KRISHNA=
FISH_AUDIO_ID_HAMSTER=
FISH_AUDIO_ID_PANDA=

# Defaults
DEFAULT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat
VOICE_MODE=apple

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000