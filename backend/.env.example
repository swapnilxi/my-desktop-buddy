# ==============================================================================
# HamsterDesk Backend Environment Variables (.env.example)
# ==============================================================================

# LLM API Keys (Optional Server Fallback)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Voice API Keys
DEEPGRAM_API_KEY=

# Defaults
DEFAULT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
